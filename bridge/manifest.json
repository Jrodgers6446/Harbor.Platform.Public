{
  "manifest_version": 3,
  "name": "Harbor Bridge",
  "version": "1.2.0",
  "description": "Connects the Harbor website to the scheduling and work-order systems your company uses, and to Harbor Helper on this PC. Read-only.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Harbor Bridge",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://your-project.supabase.co/*",
    "http://127.0.0.1:47800/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://harbor.example.com/*",
        "https://harbor-overwatch.example.com/*"
      ],
      "js": [
        "site.js"
      ],
      "run_at": "document_start"
    }
  ],
  "optional_host_permissions": [
    "https://honeycomb.fieldservices.asurion.com/*",
    "https://portal.ubreakifix.net/*"
  ]
}
