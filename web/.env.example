# Copy to .env.local for local dev, or set these in your host's environment settings.
# The anon key is meant for the browser; row level security decides what each login can see.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# One deployment serves two hostnames. Leave all three empty when running on localhost.
STANDARD_HOST=harbor.example.com
OVERWATCH_HOST=harbor-overwatch.example.com
# Comma separated. These redirect to STANDARD_HOST with the same path.
REDIRECT_HOSTS=

# Email domain allowed on the sign-up form. Must match signup_domain_ok() in the signups migration.
NEXT_PUBLIC_SIGNUP_DOMAIN=example.com
